PROXIMA_ADMIN_API_KEY=replace-with-a-long-random-secret
PROXIMA_BOT_TOKEN=replace-with-token-from-botfather
PROXIMA_BOT_ADMIN_IDS=123456789
# PROXIMA_BOT_LOG_CHAT_ID=-1001234567890
# Optional. By default the DB is stored in the per-user system application-data directory.
# PROXIMA_DATABASE_URL=sqlite+aiosqlite:///C:/Users/you/AppData/Local/Proxima Traffic/proxima.db
# PROXIMA_MEDIA_STORAGE_PATH=C:/Users/you/AppData/Local/Proxima Traffic/media
# PROXIMA_BACKUP_STORAGE_PATH=C:/Users/you/AppData/Local/Proxima Traffic/backups
# Часовой пояс дат и расписания в интерфейсе бота.
PROXIMA_TIMEZONE=Asia/Jerusalem
# Отдельный случайный секрет длиной не менее 16 символов. Не меняйте его после импорта прокси.
PROXIMA_PROXY_ENCRYPTION_KEY=replace-with-a-long-random-proxy-secret
PROXIMA_PROXY_CHECK_URL=https://api.ipify.org?format=json
PROXIMA_PROXY_CHECK_TIMEOUT_SECONDS=12
PROXIMA_PROXY_QUARANTINE_AFTER_FAILURES=3
PROXIMA_PROXY_HEALTH_RECHECK_SECONDS=60

# --- Личные аккаунты (tdata / .session) ---
# Отдельный секрет (>=16 символов) для шифрования загруженных сессий аккаунтов.
# Не меняйте после импорта: иначе сохранённые сессии перестанут расшифровываться.
PROXIMA_ACCOUNT_ENCRYPTION_KEY=replace-with-a-long-random-account-secret
# Собственные API credentials обязательны для tdata, .session и строк сессии.
# PROXIMA_TELEGRAM_API_ID=123456
# PROXIMA_TELEGRAM_API_HASH=your_api_hash
# Только для разового импорта tdata/.session/StringSession аккаунта с 2FA: задайте, импортируйте, затем удалите и
# перезапустите сервис. Значение не сохраняется в базе и не выводится в интерфейсе.
# PROXIMA_TDATA_TWO_FACTOR_PASSWORD=temporary-2fa-password
# Требовать назначенный исправный прокси для каждого аккаунта (fail-closed, защита IP).
PROXIMA_ACCOUNT_REQUIRE_PROXY=true
PROXIMA_ACCOUNT_CONNECT_TIMEOUT_SECONDS=30
PROXIMA_ACCOUNT_DELIVERY_VERIFY_ENABLED=true
PROXIMA_ACCOUNT_DELIVERY_VERIFY_DELAY_SECONDS=1
PROXIMA_ACCOUNT_DELIVERY_VERIFY_CONFIRM_DELAY_SECONDS=1.5
PROXIMA_ACCOUNT_DELIVERY_VERIFY_TIMEOUT_SECONDS=5
# If a bot deletes a post and asks only for subscriptions through Telegram inline buttons,
# join the listed channels, press its safe verification button and retry this post once.
PROXIMA_MEMBERSHIP_GATE_RECOVERY_ENABLED=true
PROXIMA_MEMBERSHIP_GATE_RETRY_DELAY_SECONDS=300
PROXIMA_MEMBERSHIP_GATE_MAX_CHANNELS=8
PROXIMA_MEMBERSHIP_GATE_SCAN_LIMIT=50
# One delayed check of a successfully sent post. It catches moderation that happens later.
PROXIMA_DELAYED_DELIVERY_VERIFY_ENABLED=true
PROXIMA_DELAYED_DELIVERY_VERIFY_DELAY_SECONDS=600
PROXIMA_DELAYED_DELIVERY_VERIFY_POLL_SECONDS=30
PROXIMA_DELAYED_DELIVERY_VERIFY_BATCH_SIZE=20
PROXIMA_DELAYED_DELIVERY_VERIFY_RETRY_SECONDS=300
PROXIMA_DELAYED_DELIVERY_VERIFY_TIMEOUT_SECONDS=30
# --- Антифлуд и безопасность аккаунтов (рекомендуется для live-рассылок) ---
# Пауза между отправками с одного аккаунта (секунды, рандом в диапазоне).
PROXIMA_ACCOUNT_PACE_MIN_SECONDS=45
PROXIMA_ACCOUNT_PACE_MAX_SECONDS=120
# Перед отправкой показать в чате нативный статус «печатает…» и выдержать
# короткую случайную паузу. Это не эмулирует клики и не отменяет лимиты Telegram.
PROXIMA_ACCOUNT_TYPING_ENABLED=true
PROXIMA_ACCOUNT_TYPING_MIN_SECONDS=2
PROXIMA_ACCOUNT_TYPING_MAX_SECONDS=4
# Авто-вступление перед отправкой (публичные, invite-ссылки и группы из addlist-папок).
PROXIMA_ACCOUNT_AUTO_JOIN=true
# Лимит сообщений с аккаунта за 24 часа (0 = без лимита).
PROXIMA_ACCOUNT_DAILY_LIMIT=200
# Микропауза каждые N отправок (0 = выключено).
PROXIMA_ACCOUNT_MICRO_BREAK_EVERY=15
PROXIMA_ACCOUNT_MICRO_BREAK_MIN_SECONDS=300
PROXIMA_ACCOUNT_MICRO_BREAK_MAX_SECONDS=900
# Лимит вступлений в чаты за сутки с одного аккаунта.
PROXIMA_ACCOUNT_JOIN_DAILY_LIMIT=8
PROXIMA_ACCOUNT_JOIN_MIN_INTERVAL_SECONDS=120
# Буфер к FloodWait от Telegram (множитель к секундам ожидания).
PROXIMA_ACCOUNT_FLOOD_SLEEP_THRESHOLD=60
PROXIMA_FLOOD_BUFFER_MULTIPLIER=1.2
PROXIMA_MAX_FLOOD_WAIT_SECONDS=86400
# Проверка статуса ограничений через официальный @SpamBot: не чаще одного раза в 6 часов,
# немедленно после PeerFlood/UserRestricted и фоново раз в 24 часа.
PROXIMA_SPAMBOT_ENABLED=true
PROXIMA_SPAMBOT_TIMEOUT_SECONDS=15
PROXIMA_SPAMBOT_MIN_CHECK_INTERVAL_SECONDS=21600
PROXIMA_SPAMBOT_UNKNOWN_COOLDOWN_SECONDS=7200
PROXIMA_SPAMBOT_MAINTENANCE_INTERVAL_SECONDS=86400
PROXIMA_SPAMBOT_MAINTENANCE_BATCH_SIZE=20
PROXIMA_MEDIA_STORAGE_PATH=./data/media
PROXIMA_MEDIA_MAX_BYTES=52428800
PROXIMA_PREFLIGHT_REQUIRED_LIVE=true
PROXIMA_PREFLIGHT_MAX_AGE_SECONDS=3600

# DRY_RUN=true — сообщения не отправляются (тестовые message ID).
# DRY_RUN=false — реальная отправка через загруженные аккаунты (Telethon).
PROXIMA_DRY_RUN=true
# Дополнительный предохранитель. Нужен только при DRY_RUN=false и включённом worker.
# Включайте после проверки аккаунтов, аудиторий и очереди в панели бота.
PROXIMA_LIVE_EXECUTION_ARMED=false
PROXIMA_AUTO_CREATE_SCHEMA=true
PROXIMA_LOG_LEVEL=INFO
PROXIMA_WORKER_ENABLED=true
# API предназначен для диагностики. Не запускайте из него workers, пока не настроена
# межпроцессная координация с основным `proxima-bot` процессом.
PROXIMA_API_WORKER_ENABLED=false
PROXIMA_WORKER_POLL_SECONDS=1.0
PROXIMA_WORKER_LEASE_SECONDS=30
PROXIMA_WORKER_HEARTBEAT_SECONDS=5
PROXIMA_WORKER_STEP_TIMEOUT_SECONDS=120
# Readiness becomes unhealthy if a supervised worker stops reporting progress.
PROXIMA_WORKER_READINESS_MAX_STALE_SECONDS=300
PROXIMA_WORKER_CONCURRENCY=4
PROXIMA_WORKER_MAX_ATTEMPTS=5
PROXIMA_WORKER_RETRY_BASE_SECONDS=2
PROXIMA_WORKER_RETRY_MAX_SECONDS=300

# --- Базы подписчиков и контролируемые сообщения в ЛС ---
# Отдельный раздел «✉️ Личные сообщения» в control bot.
PROXIMA_DIRECT_MESSAGES_ENABLED=true
# Частота проверки долговечной очереди отправок.
PROXIMA_DIRECT_MESSAGES_POLL_SECONDS=2
# Параллельные обработчики очереди. Лимиты и паузы всё равно считаются на каждый аккаунт.
PROXIMA_DIRECT_MESSAGES_WORKER_CONCURRENCY=2
# Максимальный размер загружаемого JSONL / JSONL.GZ / ZIP (20 МБ).
PROXIMA_DIRECT_MESSAGES_UPLOAD_MAX_BYTES=20971520

# Invitation of consent-confirmed subscribers to an owned channel/group.
# Telegram privacy is respected; the workflow never adds people to contacts.
PROXIMA_SUBSCRIBER_INVITES_ENABLED=true
PROXIMA_SUBSCRIBER_INVITES_POLL_SECONDS=2
PROXIMA_SUBSCRIBER_INVITES_WORKER_CONCURRENCY=2

# --- Комментарии к новым постам каналов ---
# Раздел «💬 Комментарии» в панели. Обычные рассылки и диалоги работают отдельно.
PROXIMA_CHANNEL_COMMENTS_ENABLED=true
# Как часто worker проверяет очередь готовых комментариев.
PROXIMA_CHANNEL_COMMENTS_POLL_SECONDS=5
# Как часто проверять вручную добавленные каналы на новые посты.
PROXIMA_CHANNEL_COMMENTS_SCAN_INTERVAL_SECONDS=60
# Не пытаться догонять пост, если он старше этого времени.
PROXIMA_CHANNEL_COMMENTS_MAX_POST_AGE_SECONDS=3600
# Сколько новых постов одного канала брать за одну проверку (1–100).
PROXIMA_CHANNEL_COMMENTS_SCAN_LIMIT=30
# Максимальное время одного чтения канала/проверки комментариев (1–120 секунд).
PROXIMA_CHANNEL_COMMENTS_SCAN_TIMEOUT_SECONDS=30
# Сколько каналов проверять параллельно (1–20).
PROXIMA_CHANNEL_COMMENTS_SCAN_CONCURRENCY=4
# Запрет повторной отметки того же участника по умолчанию (1–365 дней).
# Для каждого канала значение можно изменить в control bot.
PROXIMA_CHANNEL_COMMENTS_MENTION_COOLDOWN_DAYS=30

# --- Реакции на новые сообщения участников в выбранных чатах ---
# Раздел «👍 Реакции участников»: сканирует только разрешённые чаты из выбранной базы.
PROXIMA_PARTICIPANT_REACTIONS_ENABLED=true
# Как часто worker забирает готовые задачи реакций.
PROXIMA_PARTICIPANT_REACTIONS_POLL_SECONDS=5
# Как часто проверять новые сообщения в выбранных чатах (15–3600).
PROXIMA_PARTICIPANT_REACTIONS_SCAN_INTERVAL_SECONDS=60
# Максимум новых сообщений одного чата за проверку (1–100).
PROXIMA_PARTICIPANT_REACTIONS_SCAN_LIMIT=100
# Не реагировать на сообщения, которые уже старше часа (60–604800 секунд).
PROXIMA_PARTICIPANT_REACTIONS_MAX_MESSAGE_AGE_SECONDS=3600
# Не выбирать одного и того же участника повторно в том же чате в течение часа.
# 0 отключает ограничение, максимум — 30 дней.
PROXIMA_PARTICIPANT_REACTIONS_SENDER_COOLDOWN_SECONDS=3600
